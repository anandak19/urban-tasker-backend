# Base image
FROM node:20

# Set working directory inside container
WORKDIR /usr/src/app

# Copy package files first
COPY package*.json ./

# Install all dependencies (including dev) using lockfile
RUN npm ci

# Copy entire source code (but src will be overridden by volume in dev)
COPY . .

# Expose NestJS default port
EXPOSE 3000

# Start the dev server (watch mode)
CMD ["npm", "run", "start:dev"]